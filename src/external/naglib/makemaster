#  Main body of the installation makefile for any optional NAG procedures

#  Nick Gould, for GALAHAD productions
#  This version: 2026-06-23

#  include standard GALAHAD makefile definitions

include $(GALAHAD)/src/makedefs/definitions

#  Libraries used

LIBS = -lgalahad $(NAGLIB) $(LAPACK) $(BLAS)
NLIBS = $(LIBS) -lgalahad_problem

#  compilation agenda

BASICZ = blas lapack symbols dummy blas_inter lapack_inter

NAGS = $(BASICSZ) $(NLGS)(naglib.o) $(LGS)(naglib_interface.o)
NAGD = $(BASICSZ) $(NLGD)(naglib.o) $(LGD)(naglib_interface.o)
NAGQ = $(BASICSZ) $(NLGQ)(naglib.o) $(LGQ)(naglib_interface.o)
NAGS64 = $(BASICSZ) $(NLGS64)(naglib.o) $(LGS64)(naglib_interface.o)
NAGD64 = $(BASICSZ) $(NLGD64)(naglib.o) $(LGD64)(naglib_interface.o)
NAGQ64 = $(BASICSZ) $(NLGQ64)(naglib.o) $(LGQ64)(naglib_interface.o)

NAGST = $(NAGS) $(OBJ)/e04nqt.o
NAGDT = $(NAGD) $(OBJ)/e04nqt.o
NAGQT = $(NAGQ) $(OBJ)/e04nqt.o
NAGS64T = $(NAGS64) $(OBJ)/e04nqt.o
NAGD64T = $(NAGD64) $(OBJ)/e04nqt.o
NAGQ64T = $(NAGQ64) $(OBJ)/e04nqt.o

RNAGST = $(OBJ)/e04nqt.o -L$(OBJ) $(LIBS)
RNAGDT = $(OBJ)/e04nqt.o -L$(OBJ) $(LIBS)
RNAGQT = $(OBJ)/e04nqt.o -L$(OBJ) $(LIBS)
RNAGS64T = $(OBJ)/e04nqt.o -L$(OBJ) $(LIBS)
RNAGD64T = $(OBJ)/e04nqt.o -L$(OBJ) $(LIBS)
RNAGQ64T = $(OBJ)/e04nqt.o -L$(OBJ) $(LIBS)

#  naglib

naglib_silent: naglib_$(PRECIS)
nag: naglib_$(PRECIS)
	@printf ' %-21s\n' "GALAHAD: $(NAG) ($(PRECIS) $(SUCC)"
naglib_single: $(NAGS)
	$(RANLIB) $(NLGS)
naglib_double: $(NAGD)
	$(RANLIB) $(NLGD)
naglib_quadruple: $(NAGQ)
	$(RANLIB) $(NLGQ)
naglib_single_64: $(NAGS64)
	$(RANLIB) $(NLGS64)
naglib_double_64: $(NAGD64)
	$(RANLIB) $(NLGD64)
naglib_quadruple_64: $(NAGQ64)
	$(RANLIB) $(NLGQ64)

#  tests

nagdt: $(NAGDT)
	echo " Exhaustive test of subroutine interface to naglib"
	cd ../naglib ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_nag \
                         $(RNAGDT)
#	- ../naglib/run_nag > ../naglib/nagdt.output 2>&1
#	cat ../naglib/nagdt.output
	- ../naglib/run_nag
	rm ../naglib/run_nag

nagst: $(NAGST)
	echo " Exhaustive test of subroutine interface to naglib"
	cd ../naglib ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_nag \
                         $(RNAGST)
	- ../naglib/run_nag > ../naglib/nagst.output 2>&1
	cat ../naglib/nagst.output
	rm ../naglib/run_nag

nagsq: $(NAGQT)
	echo " Exhaustive test of subroutine interface to naglib"
	cd ../naglib ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_nag \
                         $(RNAGQT)
	- ../naglib/run_nag > ../naglib/nagqt.output 2>&1
	cat ../naglib/nagqt.output
	rm ../naglib/run_nag

#  blas and lapack generic packages and interfaces

blas:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

symbols:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            symbols_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

dummy:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            dummy_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

blas_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

#  individual compilations

naglib.o: $(NLG)(naglib.o)

$(NLG)(naglib.o): ../../dum/naglib.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "dummy naglib"
	$(CP) ../../dum/naglib.F90 $(OBJ)/naglib.F90
	cd $(OBJ); $(FORTRAN) -o naglib.o $(FFLAGS) naglib.F90
	cd $(OBJ); $(NARR) naglib.o ; $(RM) naglib.F90 naglib.o
	$(RANLIB) $(NLG)
	@printf '[ OK ]\n'

naglib_interface.o: $(LG)(naglib_interface.o)

$(LG)(naglib_interface.o): ../naglib/naglib_interface.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "naglib_interface  "
	$(CP) ../naglib/naglib_interface.F90 \
           $(OBJ)/naglib_interface.F90
	cd $(OBJ); $(FORTRAN) -o naglib_interface.o $(FFLAGS) \
                      naglib_interface.F90
	cd $(OBJ); $(ARR) naglib_interface.o ; \
          $(RM) naglib_interface.F90 naglib_interface.o
	@printf '[ OK ]\n'

e04npf.o: $(OBJ)/e04npf.o

$(OBJ)/e04npf.o: ../naglib/e04npf.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "e04npf  "
	$(CP) ../naglib/e04npf.F90 $(OBJ)/e04npf.F90
	cd $(OBJ); $(FORTRAN) -o e04npf.o $(FFLAGS) e04npf.F90
	$(RM) $(OBJ)/e04npf.F90
	@printf '[ OK ]\n'

#  test programs

e04nqt.o: $(OBJ)/e04nqt.o

$(OBJ)/e04nqt.o: ../naglib/e04nqt.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "e04nqt"
	$(SED) -f $(SEDS) ../naglib/e04nqt.F90 > $(OBJ)/e04nqt.F90
	cd $(OBJ) ; $(FORTRAN) -o e04nqt.o $(FFLAGSS) e04nqt.F90
	@printf '[ OK ]\n'

#  book keeping

clean:
	@printf ' %-9s\t\t' "Cleaning"
	$(RM) $(NLG) $(OBJ)/nags.o $(OBJ)/e04nqt.o
	@printf '[ OK ]\n'

cleanall:
	@printf ' %-14s\t\t' "Removing all $(PRECIS) precision object and module files"
	$(RM) -r $(OBJ)/* $(MOD)/*
	@printf '[ OK ]\n'
