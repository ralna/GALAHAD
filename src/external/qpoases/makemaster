#  Main body of the installation makefile for any optional qpOASES procedures

#  Nick Gould, for GALAHAD productions
#  This version: 2026-08-10

#  include standard GALAHAD makefile definitions

include $(GALAHAD)/src/makedefs/definitions

#  Libraries used

LIBS = -lgalahad $(QPOASES) $(LAPACK) $(BLAS)
NLIBS = $(LIBS) -lgalahad_problem

#  compilation agenda

BASICZ = blas lapack symbols dummy blas_inter lapack_inter

QPOASESS = $(BASICSZ) $(LGS)(qpoases_c_interface.o) \
           $(LGS)(qpoases_types.o) $(QOLGS)(qpoases.o) \
           $(QOFLGS)(qpoases_fortran.o)
QPOASESD = $(BASICSZ) $(LGD)(qpoases_c_interface.o) \
           $(LGD)(qpoases_types.o) $(QOLGD)(qpoases.o) \
           $(QOFLGD)(qpoases_fortran.o)
QPOASESQ = $(BASICSZ) $(LGQ)(qpoases_c_interface.o) \
           $(LGSQ)(qpoases_types.o) $(QOLGQ)(qpoases.o) \
           $(QOFLGQ)(qpoases_fortran.o)
QPOASESS64 = $(BASICSZ) $(LGS64)(qpoases_c_interface.o) \
           $(LGS64)(qpoases_types.o) $(QOLGS64)(qpoases.o) \
           $(QOFLGS64)(qpoases_fortran.o)
QPOASESD64 = $(BASICSZ) $(LGD64)(qpoases_c_interface.o) \
           $(LGD64)(qpoases_types.o) $(QOLGD64)(qpoases.o) \
           $(QOFLGD64)(qpoases_fortran.o)
QPOASESQ64 = $(BASICSZ) $(LGQ64)(qpoases_c_interface.o) \
           $(LGSQ64)(qpoases_types.o) $(QOLGQ64)(qpoases.o) \
           $(QOFLGQ64)(qpoases_fortran.o)

QPOASESST = $(QPOASESS) $(OBJ)/qpoasest.o
QPOASESDT = $(QPOASESD) $(OBJ)/qpoasest.o
QPOASESQT = $(QPOASESQ) $(OBJ)/qpoasest.o
QPOASESS64T = $(QPOASESS64) $(OBJ)/qpoasest.o
QPOASESD64T = $(QPOASESD64) $(OBJ)/qpoasest.o
QPOASESQ64T = $(QPOASESQ64) $(OBJ)/qpoasest.o

RQPOASESST = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESDT = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESQT = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESS64T = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESD64T = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESQ64T = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)

#  qpoases

qpoases_silent: qpoases_$(PRECIS)
qpoases: qpoases_$(PRECIS)
	@printf ' %-21s\n' "GALAHAD: $(QPOASES) ($(PRECIS) $(SUCC)"
qpoases_single: $(QPOASESS)
	$(RANLIB) $(QOLGS)
qpoases_double: $(QPOASESD)
	$(RANLIB) $(QOLGD)
qpoases_quadruple: $(QPOASESQ)
	$(RANLIB) $(QOLGQ)
qpoases_single_64: $(QPOASESS64)
	$(RANLIB) $(QOLGS64)
qpoases_double_64: $(QPOASESD64)
	$(RANLIB) $(QOLGD64)
qpoases_quadruple_64: $(QPOASESQ64)
	$(RANLIB) $(QOLGQ64)

#  tests

qpoasesdt: $(QPOASESDT)
	echo " Exhaustive test of subroutine interface to qpoases"
	cd ../qpoases ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpoases \
                         $(RQPOASESDT)
#	- ../qpoases/run_qpoases > ../qpoases/qpoasesdt.output 2>&1
#	cat ../qpoases/qpoasesdt.output
	- ../qpoases/run_qpoases
	rm ../qpoases/run_qpoases

qpoasesst: $(QPOASESST)
	echo " Exhaustive test of subroutine interface to qpoases"
	cd ../qpoases ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpoases \
                         $(RQPOASESST)
	- ../qpoases/run_qpoases > ../qpoases/qpoasesst.output 2>&1
	cat ../qpoases/qpoasesst.output
	rm ../qpoases/run_qpoases

qpoasessq: $(QPOASESQT)
	echo " Exhaustive test of subroutine interface to qpoases"
	cd ../qpoases ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpoases \
                         $(RQPOASESQT)
	- ../qpoases/run_qpoases > ../qpoases/qpoasesqt.output 2>&1
	cat ../qpoases/qpoasesqt.output
	rm ../qpoases/run_qpoases

#  blas and lapack generic packages and interfaces

blas:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

symbols:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            symbols_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

dummy:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            dummy_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

blas_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

#  individual compilations

qpoases_c_interface.o: $(LG)(qpoases_c_interface.o)

$(LG)(qpoases_c_interface.o): ../qpoases/qpoases_c_interface.cpp
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoases_c_interface"
	$(CP) ../qpoases/qpoases_c_interface.cpp $(OBJ)/qpoases_c_interface.cpp
	$(CP) ../qpoases/qpoases_c_interface.hpp $(OBJ)/qpoases_c_interface.hpp
	$(LN) -fs $(PWD)/include $(OBJ)/
	cd $(OBJ); $(CXX) -o qpoases_c_interface.o $(CXXFLAGS) \
             qpoases_c_interface.cpp
	cd $(OBJ); $(ARR) qpoases_c_interface.o ; \
          $(RM) qpoases_c_interface.cpp qpoases_c_interface.hpp \
            qpoases_c_interface.o include
	@printf '[ OK ]\n'

qpoases_types.o: $(LG)(qpoases_types.o)

$(LG)(qpoases_types.o): ../qpoases/qpoases_types.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoases_types  "
	$(CP) ../qpoases/qpoases_types.F90 \
           $(OBJ)/qpoases_types.F90
	cd $(OBJ); $(FORTRAN) -o qpoases_types.o $(FFLAGS) \
                      qpoases_types.F90
	cd $(OBJ); $(ARR) qpoases_types.o ; \
          $(RM) qpoases_types.F90 qpoases_types.o
	@printf '[ OK ]\n'

qpoases.o: $(QOLG)(qpoases.o)

$(QOLG)(qpoases.o): ../../dum/qpoases.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "dummy qpoases"
	$(CP) ../../dum/qpoases.F90 $(OBJ)/qpoases.F90
	cd $(OBJ); $(FORTRAN) -o qpoases.o $(FFLAGS) qpoases.F90
	cd $(OBJ); $(QOARR) qpoases.o ; $(RM) qpoases.F90 qpoases.o
	$(MVMODS)
	@printf '[ OK ]\n'

qpoases_fortran.o: $(QOFLG)(qpoases_fortran.o)

$(QOFLG)(qpoases_fortran.o): ../qpoases//qpoases_fortran.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "fortran qpoases"
	$(CP) ../qpoases/qpoases_fortran.F90 $(OBJ)/qpoases_fortran.F90
	cd $(OBJ); $(FORTRAN) -o qpoases_fortran.o \
                     $(FFLAGS) qpoases_fortran.F90
	cd $(OBJ); $(QOFARR) qpoases_fortran.o ; \
           $(RM) qpoases_fortran.F90 qpoases_fortran.o
	$(RANLIB) $(QOFLG)
	$(MVMODS)
	@printf '[ OK ]\n'



#  test programs

qpoasest.o: $(OBJ)/qpoasest.o

$(OBJ)/qpoasest.o: ../qpoases/qpoasest.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoasest  "
	$(SED) -f $(SEDS) ../qpoases/qpoasest.F90 > $(OBJ)/qpoasest.F90
	cd $(OBJ) ; $(FORTRAN) -o qpoasest.o $(FFLAGSS) qpoasest.F90
	@printf '[ OK ]\n'

#  book keeping

clean:
	@printf ' %-9s\t\t' "Cleaning"
	$(RM) $(QOLG) $(OBJ)/qpoasess.o $(OBJ)/qpoasest.o
	@printf '[ OK ]\n'

cleanall:
	@printf ' %-14s\t\t' "Removing all $(PRECIS) precision object and module files"
	$(RM) -r $(OBJ)/* $(MOD)/*
	@printf '[ OK ]\n'
