#  Main body of the installation makefile for any optional qpOASES procedures

#  Nick Gould, for GALAHAD productions
#  This version: 2026-11-17

#  include standard GALAHAD makefile definitions

include $(GALAHAD)/src/makedefs/definitions

#  Libraries used

LIBS = -lgalahad $(HSL) $(QPOASES) $(LAPACK) $(BLAS)
NLIBS = $(LIBS) -lgalahad_problem

#  compilation agenda

BASICZ = blas lapack symbols dummy blas_inter lapack_inter

QPOASES_DUMS = $(BASICSZ) $(LGS)(qpoases_c_interface.o) \
           $(LGS)(qpoases_types.o) $(QOLGS)(qpoases_f.o) \
           $(QOFLGS)(qpoases_f_interface.o)
QPOASES_DUMD = $(BASICSZ) $(LGD)(qpoases_c_interface.o) \
           $(LGD)(qpoases_types.o) $(QOLGD)(qpoases_f.o) \
           $(QOFLGD)(qpoases_f_interface.o)
QPOASES_DUMQ = $(BASICSZ) $(LGQ)(qpoases_c_interface.o) \
           $(LGSQ)(qpoases_types.o) $(QOLGQ)(qpoases_f.o) \
           $(QOFLGQ)(qpoases_f_interface.o)
QPOASES_DUMS64 = $(BASICSZ) $(LGS64)(qpoases_c_interface.o) \
           $(LGS64)(qpoases_types.o) $(QOLGS64)(qpoases_f.o) \
           $(QOFLGS64)(qpoases_f_interface.o)
QPOASES_DUMD64 = $(BASICSZ) $(LGD64)(qpoases_c_interface.o) \
           $(LGD64)(qpoases_types.o) $(QOLGD64)(qpoases_f.o) \
           $(QOFLGD64)(qpoases_f_interface.o)
QPOASES_DUMQ64 = $(BASICSZ) $(LGQ64)(qpoases_c_interface.o) \
           $(LGSQ64)(qpoases_types.o) $(QOLGQ64)(qpoases_f.o) \
           $(QOFLGQ64)(qpoases_f_interface.o)

QPOASESS = $(QPOASES_DUMS) $(LGS)(qpoases.o)
QPOASESD = $(QPOASES_DUMD) $(LGD)(qpoases.o)
QPOASESQ = $(QPOASES_DUMQ) $(LGQ)(qpoases.o)
QPOASESS64 = $(QPOASES_DUMS64) $(LGS64)(qpoases.o)
QPOASESD64 = $(QPOASES_DUMD64) $(LGD64)(qpoases.o)
QPOASESQ64 = $(QPOASES_DUMQ64) $(LGQ64)(qpoases.o)

QPOASESST = $(QPOASESS) $(OBJ)/qpoasest.o
QPOASESDT = $(QPOASESD) $(OBJ)/qpoasest.o
QPOASESQT = $(QPOASESQ) $(OBJ)/qpoasest.o
QPOASESS64T = $(QPOASESS64) $(OBJ)/qpoasest.o
QPOASESD64T = $(QPOASESD64) $(OBJ)/qpoasest.o
QPOASESQ64T = $(QPOASESQ64) $(OBJ)/qpoasest.o

OLDQPOASESST = $(QPOASESS) $(OBJ)/old_qpoasest.o
OLDQPOASESDT = $(QPOASESD) $(OBJ)/old_qpoasest.o
OLDQPOASESQT = $(QPOASESQ) $(OBJ)/old_qpoasest.o
OLDQPOASESS64T = $(QPOASESS64) $(OBJ)/old_qpoasest.o
OLDQPOASESD64T = $(QPOASESD64) $(OBJ)/old_qpoasest.o
OLDQPOASESQ64T = $(QPOASESQ64) $(OBJ)/old_qpoasest.o

RQPOASESST = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESDT = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESQT = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESS64T = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESD64T = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)
RQPOASESQ64T = $(OBJ)/qpoasest.o -L$(OBJ) $(LIBS)

ROLDQPOASESST = $(OBJ)/old_qpoasest.o -L$(OBJ) $(LIBS)
ROLDQPOASESDT = $(OBJ)/old_qpoasest.o -L$(OBJ) $(LIBS)
ROLDQPOASESQT = $(OBJ)/old_qpoasest.o -L$(OBJ) $(LIBS)
ROLDQPOASESS64T = $(OBJ)/old_qpoasest.o -L$(OBJ) $(LIBS)
ROLDQPOASESD64T = $(OBJ)/old_qpoasest.o -L$(OBJ) $(LIBS)
ROLDQPOASESQ64T = $(OBJ)/old_qpoasest.o -L$(OBJ) $(LIBS)

#  qpoases

qpoases_silent: qpoases_$(PRECIS)
qpoases: qpoases_$(PRECIS)
	@printf ' %-21s\n' "GALAHAD: qpoases ($(PRECIS) $(SUCC)"
qpoases_single: $(QPOASESS)
	$(RANLIB) $(QOLGS)
qpoases_double: $(QPOASESD)
	$(RANLIB) $(QOLGD)
qpoases_quadruple: $(QPOASESQ)
	$(RANLIB) $(QOLGQ)
qpoases_single_64: $(QPOASESS64)
	$(RANLIB) $(QOLGS64)
qpoases_double_64: $(QPOASESD64)
	$(RANLIB) $(QOLGD64)
qpoases_quadruple_64: $(QPOASESQ64)
	$(RANLIB) $(QOLGQ64)

#  qpoases_dum

qpoases_dum_silent: qpoases_dum_$(PRECIS)
qpoases_dum: qpoases_dum_$(PRECIS)
	@printf ' %-21s\n' "GALAHAD: qpoases_dum ($(PRECIS) $(SUCC)"
qpoases_dum_single: $(QPOASES_DUMS)
	$(RANLIB) $(QOLGS)
qpoases_dum_double: $(QPOASES_DUMD)
	$(RANLIB) $(QOLGD)
qpoases_dum_quadruple: $(QPOASES_DUMQ)
	$(RANLIB) $(QOLGQ)
qpoases_dum_single_64: $(QPOASES_DUMS64)
	$(RANLIB) $(QOLGS64)
qpoases_dum_double_64: $(QPOASES_DUMD64)
	$(RANLIB) $(QOLGD64)
qpoases_dum_quadruple_64: $(QPOASES_DUMQ64)
	$(RANLIB) $(QOLGQ64)

#  tests

qpoasesdt: $(QPOASESDT)
	echo " Exhaustive test of subroutine interface to qpoases"
	cd ../qpoases ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpoases \
                         $(RQPOASESDT)
#	- ../qpoases/run_qpoases > ../qpoases/qpoasesdt.output 2>&1
#	cat ../qpoases/qpoasesdt.output
	- ../qpoases/run_qpoases
	rm ../qpoases/run_qpoases

old_qpoasesdt: $(OLDQPOASESDT)
	echo " Exhaustive test of subroutine interface to qpoases"
	cd ../qpoases ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpoases \
                         $(ROLDQPOASESDT)
#	- ../qpoases/run_qpoases > ../qpoases/qpoasesdt.output 2>&1
#	cat ../qpoases/qpoasesdt.output
	- ../qpoases/run_qpoases
	rm ../qpoases/run_qpoases

qpoasesst: $(QPOASESST)
	echo " Exhaustive test of subroutine interface to qpoases"
	cd ../qpoases ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpoases \
                         $(RQPOASESST)
	- ../qpoases/run_qpoases > ../qpoases/qpoasesst.output 2>&1
	cat ../qpoases/qpoasesst.output
	rm ../qpoases/run_qpoases

qpoasessq: $(QPOASESQT)
	echo " Exhaustive test of subroutine interface to qpoases"
	cd ../qpoases ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpoases \
                         $(RQPOASESQT)
	- ../qpoases/run_qpoases > ../qpoases/qpoasesqt.output 2>&1
	cat ../qpoases/qpoasesqt.output
	rm ../qpoases/run_qpoases

#  blas and lapack generic packages and interfaces

blas:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

symbols:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            symbols_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

dummy:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            dummy_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

blas_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

#  individual compilations

qpoases_c_interface.o: $(LG)(qpoases_c_interface.o)

$(LG)(qpoases_c_interface.o): ../qpoases/qpoases_c_interface.cpp
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoases_c_interface"
	$(CP) ../qpoases/qpoases_c_interface.cpp $(OBJ)/qpoases_c_interface.cpp
	$(CP) ../qpoases/qpoases_c_interface.hpp $(OBJ)/qpoases_c_interface.hpp
	$(LN) -fs $(PWD)/include $(OBJ)/
	cd $(OBJ); $(CXX) -o qpoases_c_interface.o $(CXXFLAGS) \
             qpoases_c_interface.cpp
	cd $(OBJ); $(ARR) qpoases_c_interface.o ; \
          $(RM) qpoases_c_interface.cpp qpoases_c_interface.hpp \
            qpoases_c_interface.o include
	@printf '[ OK ]\n'

qpoases_types.o: $(LG)(qpoases_types.o)

$(LG)(qpoases_types.o): ../qpoases/qpoases_types.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoases_types  "
	$(CP) ../qpoases/qpoases_types.F90 \
           $(OBJ)/qpoases_types.F90
	cd $(OBJ); $(FORTRAN) -o qpoases_types.o $(FFLAGS) \
                      qpoases_types.F90
	cd $(OBJ); $(ARR) qpoases_types.o ; \
          $(RM) qpoases_types.F90 qpoases_types.o
	$(MVMODS)
	@printf '[ OK ]\n'

dum_qpoases_f.o: $(QOLG)(qpoases_f.o)

$(QOLG)(qpoases_f.o): ../../dum/qpoases_f.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "dummy qpoases"
	$(CP) ../../dum/qpoases_f.F90 $(OBJ)/qpoases_f.F90
	cd $(OBJ); $(FORTRAN) -o qpoases_f.o $(FFLAGS) qpoases_f.F90
	cd $(OBJ); $(QOARR) qpoases_f.o ; $(RM) qpoases_f.F90 qpoases_f.o
	$(MVMODS)
	@printf '[ OK ]\n'

qpoases_f_interface.o: $(QOFLG)(qpoases_f_interface.o)

$(QOFLG)(qpoases_f_interface.o): ../qpoases/qpoases_f_interface.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoases_f_interface"
	$(CP) ../qpoases/qpoases_f_interface.F90 $(OBJ)/qpoases_f_interface.F90
	cd $(OBJ); $(FORTRAN) -o qpoases_f_interface.o \
                     $(FFLAGS) qpoases_f_interface.F90
	cd $(OBJ); $(QOFARR) qpoases_f_interface.o ; \
           $(RM) qpoases_f_interface.F90 qpoases_f_interface.o
	$(RANLIB) $(QOFLG)
	$(MVMODS)
	@printf '[ OK ]\n'

qpoases.o: $(LG)(qpoases.o)

$(LG)(qpoases.o): ../qpoases/qpoases.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoases"
	$(CP) ../qpoases/qpoases.F90 $(OBJ)/qpoases.F90
	cd $(OBJ); $(FORTRAN) -o qpoases.o $(FFLAGS) qpoases.F90
	cd $(OBJ); $(ARR) qpoases.o ; \
          $(RM) qpoases.F90 qpoases.o qpoasest.o old_qpoasest.o
	$(RANLIB) $(LG)
	$(RMOBFILE) qp_$(PRECIS).o
	$(MVMODS)
	@printf '[ OK ]\n'

#  test programs

qpoasest.o: $(OBJ)/qpoasest.o

$(OBJ)/qpoasest.o: ../qpoases/qpoasest.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpoasest  "
	$(SED) -f $(SEDS) ../qpoases/qpoasest.F90 > $(OBJ)/qpoasest.F90
	cd $(OBJ) ; $(FORTRAN) -o qpoasest.o $(FFLAGSS) qpoasest.F90
	cd $(OBJ); $(RM) qpoasest.F90
	@printf '[ OK ]\n'

old_qpoasest.o: $(OBJ)/old_qpoasest.o

$(OBJ)/old_qpoasest.o: ../qpoases/old_qpoasest.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "old_qpoasest  "
	$(SED) -f $(SEDS) ../qpoases/old_qpoasest.F90 > $(OBJ)/old_qpoasest.F90
	cd $(OBJ) ; $(FORTRAN) -o old_qpoasest.o $(FFLAGSS) old_qpoasest.F90
	cd $(OBJ); $(RM) old_qpoasest.F90
	@printf '[ OK ]\n'

#  book keeping

clean:
	@printf ' %-9s\t\t' "Cleaning"
	$(RM) $(QOLG) $(OBJ)/qpoasess.o $(OBJ)/qpoasest.o
	@printf '[ OK ]\n'

cleanall:
	@printf ' %-14s\t\t' "Removing all $(PRECIS) precision object and module files"
	$(RM) -r $(OBJ)/* $(MOD)/*
	@printf '[ OK ]\n'
