#  Main body of the installation makefile for any optional QPALM procedures

#  Nick Gould, for GALAHAD productions
#  This version: 2026-10-28

#  include standard GALAHAD makefile definitions

include $(GALAHAD)/src/makedefs/definitions

#  Libraries used

LIBS = -lgalahad $(HSL) $(QPALM) $(LAPACK) $(BLAS)
NLIBS = $(LIBS) -lgalahad_problem

#  compilation agenda

BASICZ = blas lapack symbols dummy blas_inter lapack_inter

QPALM_DUMS = $(BASICSZ) $(QALGS)(qpalm.o)
QPALM_DUMD = $(BASICSZ) $(QALGD)(qpalm.o)
QPALM_DUMQ = $(BASICSZ) $(QALGQ)(qpalm.o)
QPALM_DUMS64 = $(BASICSZ) $(QALGS64)(qpalm.o)
QPALM_DUMD64 = $(BASICSZ) $(QALGD64)(qpalm.o)
QPALM_DUMQ64 = $(BASICSZ) $(QALGQ64)(qpalm.o)

QPALMS = $(QPALM_DUMS) $(LGS)(qpalm.o)
QPALMD = $(QPALM_DUMD) $(LGD)(qpalm.o)
QPALMQ = $(QPALM_DUMQ) $(LGQ)(qpalm.o)
QPALMS64 = $(QPALM_DUMS64) $(LGS64)(qpalm.o)
QPALMD64 = $(QPALM_DUMD64) $(LGD64)(qpalm.o)
QPALMQ64 = $(QPALM_DUMQ64) $(LGQ64)(qpalm.o)

QPALMST = $(QPALMS) $(OBJ)/qpalmt.o
QPALMDT = $(QPALMD) $(OBJ)/qpalmt.o
QPALMQT = $(QPALMQ) $(OBJ)/qpalmt.o
QPALMS64T = $(QPALMS64) $(OBJ)/qpalmt.o
QPALMD64T = $(QPALMD64) $(OBJ)/qpalmt.o
QPALMQ64T = $(QPALMQ64) $(OBJ)/qpalmt.o

OLDQPALMST = $(QPALMS) $(OBJ)/old_qpalmt.o
OLDQPALMDT = $(QPALMD) $(OBJ)/old_qpalmt.o
OLDQPALMQT = $(QPALMQ) $(OBJ)/old_qpalmt.o
OLDQPALMS64T = $(QPALMS64) $(OBJ)/old_qpalmt.o
OLDQPALMD64T = $(QPALMD64) $(OBJ)/old_qpalmt.o
OLDQPALMQ64T = $(QPALMQ64) $(OBJ)/old_qpalmt.o

RQPALMST = $(OBJ)/qpalmt.o -L$(OBJ) $(LIBS)
RQPALMDT = $(OBJ)/qpalmt.o -L$(OBJ) $(LIBS)
RQPALMQT = $(OBJ)/qpalmt.o -L$(OBJ) $(LIBS)
RQPALMS64T = $(OBJ)/qpalmt.o -L$(OBJ) $(LIBS)
RQPALMD64T = $(OBJ)/qpalmt.o -L$(OBJ) $(LIBS)
RQPALMDQ64 = $(OBJ)/qpalmt.o -L$(OBJ) $(LIBS)

ROLDQPALMST = $(OBJ)/old_qpalmt.o -L$(OBJ) $(LIBS)
ROLDQPALMDT = $(OBJ)/old_qpalmt.o -L$(OBJ) $(LIBS)
ROLDQPALMQT = $(OBJ)/old_qpalmt.o -L$(OBJ) $(LIBS)
ROLDQPALMS64T = $(OBJold_)/qpalmt.o -L$(OBJ) $(LIBS)
ROLDQPALMD64T = $(OBJold_)/qpalmt.o -L$(OBJ) $(LIBS)
ROLDQPALMDQ64 = $(OBJold_)/qpalmt.o -L$(OBJ) $(LIBS)

#  qpalm

qpalm_silent: qpalm_$(PRECIS)
qpalm: qpalm_$(PRECIS)
	@printf ' %-21s\n' "GALAHAD: qpalm ($(PRECIS) $(SUCC)"
qpalm_single: $(QPALMS)
	$(RANLIB) $(QALGS)
qpalm_double: $(QPALMD)
	$(RANLIB) $(QALGD)
qpalm_quadruple: $(QPALMQ)
	$(RANLIB) $(QALGQ)
qpalm_single_64: $(QPALMS64)
	$(RANLIB) $(QALGS64)
qpalm_double_64: $(QPALMD64)
	$(RANLIB) $(QALGD64)
qpalm_quadruple_64: $(QPALMQ64)
	$(RANLIB) $(QALGQ64)

#  qpalm_dum

qpalm_dum_silent: qpalm_dum_$(PRECIS)
qpalm_dum: qpalm_dum_$(PRECIS)
	@printf ' %-21s\n' "GALAHAD: qpalm_dum ($(PRECIS) $(SUCC)"
qpalm_dum_single: $(QPALM_DUMS)
	$(RANLIB) $(QALGS)
qpalm_dum_double: $(QPALM_DUMD)
	$(RANLIB) $(QALGD)
qpalm_dum_quadruple: $(QPALM_DUMQ)
	$(RANLIB) $(QALGQ)
qpalm_dum_single_64: $(QPALM_DUMS64)
	$(RANLIB) $(QALGS64)
qpalm_dum_double_64: $(QPALM_DUMD64)
	$(RANLIB) $(QALGD64)
qpalm_dum_quadruple_64: $(QPALM_DUMQ64)
	$(RANLIB) $(QALGQ64)

#  tests

qpalmdt: $(QPALMDT)
	echo " Exhaustive test of subroutine interface to qpalm"
	cd ../qpalm ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpalm \
                         $(RQPALMDT)
#	- ../qpalm/run_qpalm > ../qpalm/qpalmdt.output 2>&1
#	cat ../qpalm/qpalmdt.output
	- ../qpalm/run_qpalm
	rm ../qpalm/run_qpalm

old_qpalmdt: $(OLDQPALMDT)
	echo " Exhaustive test of subroutine interface to old qpalm"
	cd ../qpalm ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpalm \
                         $(ROLDQPALMDT)
#	- ../qpalm/run_qpalm > ../qpalm/qpalmdt.output 2>&1
#	cat ../qpalm/qpalmdt.output
	- ../qpalm/run_qpalm
	rm ../qpalm/run_qpalm

qpalmst: $(QPALMST)
	echo " Exhaustive test of subroutine interface to qpalm"
	cd ../qpalm ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpalm \
                         $(RQPALMST)
	- ../qpalm/run_qpalm > ../qpalm/qpalmst.output 2>&1
	cat ../qpalm/qpalmst.output
	rm ../qpalm/run_qpalm

qpalmsq: $(QPALMQT)
	echo " Exhaustive test of subroutine interface to qpalm"
	cd ../qpalm ; $(FORTRAN) $(RUNFFLAGSOMP) $(SPECIAL) -o run_qpalm \
                         $(RQPALMQT)
	- ../qpalm/run_qpalm > ../qpalm/qpalmqt.output 2>&1
	cat ../qpalm/qpalmqt.output
	rm ../qpalm/run_qpalm

#  blas and lapack generic packages and interfaces

blas:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

symbols:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            symbols_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

dummy:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            dummy_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

blas_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            blas_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

lapack_inter:
	( cd ../../general ; $(MAKE) -f $(GALAHAD)/makefiles/$(VERSION) \
            lapack_inter_silent PRECIS=$(PRECIS) PWD=$(PWD)/../../general )

#  individual compilations

qpalm_dummy.o: $(QALG)(qpalm.o)

$(QALG)(qpalm.o): ../../dum/qpalm.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "dummy qpalm"
	$(CP) ../../dum/qpalm.F90 $(OBJ)/qpalm.F90
	cd $(OBJ); $(FORTRAN) -o qpalm.o $(FFLAGS) qpalm.F90
	cd $(OBJ); $(QAARR) qpalm.o ; $(RM) qpalm.F90 qpalm.o
	$(RANLIB) $(QALG)
	$(MVMODS)
	@printf '[ OK ]\n'

qpalm.o: $(LG)(qpalm.o)

$(LG)(qpalm.o): ../qpalm/qpalm.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpalm"
#	$(RM) $(MOD)/qpalm_fiface.mod
	$(CP) ../qpalm/qpalm.F90 $(OBJ)/qpalm.F90
	cd $(OBJ); $(FORTRAN) -o qpalm.o -I$(QPALMINCLUDE) $(FFLAGS) qpalm.F90
	cd $(OBJ); $(ARR) qpalm.o ; $(RM) qpalm.F90 qpalm.o
	$(RANLIB) $(LG)
	$(MVMODS)
	@printf '[ OK ]\n'

#  test programs

qpalmt.o: $(OBJ)/qpalmt.o

$(OBJ)/qpalmt.o: ../qpalm/qpalmt.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "qpalmt  "
	$(SED) -f $(SEDS) ../qpalm/qpalmt.F90 > $(OBJ)/qpalmt.F90
	cd $(OBJ) ; $(FORTRAN) -o qpalmt.o -I$(QPALMINCLUDE) $(FFLAGSS) qpalmt.F90
	@printf '[ OK ]\n'

old_qpalmt.o: $(OBJ)/old_qpalmt.o

$(OBJ)/old_qpalmt.o: ../qpalm/old_qpalmt.F90
	@printf ' %-9s %-15s\t\t' "Compiling" "old_qpalmt  "
	$(SED) -f $(SEDS) ../qpalm/old_qpalmt.F90 > $(OBJ)/old_qpalmt.F90
	cd $(OBJ) ; $(FORTRAN) -o old_qpalmt.o -I$(QPALMINCLUDE) \
                      $(FFLAGSS) old_qpalmt.F90
	@printf '[ OK ]\n'

#  book keeping

clean:
	@printf ' %-9s\t\t' "Cleaning"
	$(RM) $(QALG) $(OBJ)/qpalmt.o
	@printf '[ OK ]\n'

cleanall:
	@printf ' %-14s\t\t' "Removing all $(PRECIS) precision object and module files"
	$(RM) -r $(OBJ)/* $(MOD)/*
	@printf '[ OK ]\n'
